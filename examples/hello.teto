# Programa TetoScript con variables, anotaciones, función, módulo y condicionales.
teto nombre: string = "Teto"
teto edad: number = 25

teto fn saludo(persona: string) -> string {
    return "Hola, " + persona + "!"
}

Teto (edad % 2 == 1) {
    tetolog(saludo(nombre))
} else {
    tetolog("nose")
}
